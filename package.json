{
  "name": "merlins-revenge-remake",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:copy": "tsx tools/copy-assets.ts",
    "assets:convert": "tsx tools/convert-assets.ts",
    "package": "pnpm assets:convert && pnpm build && node tools/package.mjs"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
